{
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "AdminEmail": "admin@base.local",
    "AdminPassword": "Admin-Dev-Password-1",
    "SamplePlans": true
  },
  "Notifications": {
    "Providers": {
      "log": { "Type": "Log", "IncludeBody": true }
    }
  },
  "FileStorage": {
    "LocalDisk": { "RootPath": ".data/files" }
  },
  "Observability": {
    "TraceUrlTemplate": "http://localhost:18888/traces/detail/{traceId}",
    "LogSearchUrlTemplate": "http://localhost:5341/#/events?filter=Ticket%20%3D%20'{ticket}'"
  },
  "Serilog": {
    "WriteTo": {
      "Seq": { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    },
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
