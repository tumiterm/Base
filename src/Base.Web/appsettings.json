{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5
  },
  "Tenancy": {
    "MultiTenant": false,
    "DefaultTenantCode": "default",
    "DefaultTenantName": "Default",
    "FallbackToDefaultTenant": false
  },
  "FileStorage": {
    "S3": null,
    "AzureBlob": null,
    "LocalDisk": null
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "FromAddress": "no-reply@example.com",
    "FromName": "Base"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 10
  },
  "Hangfire": {
    "Enabled": false,
    "ServerName": "base",
    "Queues": [ "default" ],
    "DashboardPath": "/jobs"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/base-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
