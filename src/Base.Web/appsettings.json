{
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 5
  },
  "Tenancy": {
    "MultiTenant": false,
    "DefaultTenantCode": "default",
    "DefaultTenantName": "Default",
    "FallbackToDefaultTenant": false
  },
  "FileStorage": {
    "S3": null,
    "AzureBlob": null,
    "LocalDisk": null
  },
  "FileScanning": {
    "ClamAv": { "Host": "", "Port": 3310, "TimeoutSeconds": 30 }
  },
  "Documents": {
    "Pdf": {
      "Gotenberg": { "BaseUrl": null, "TimeoutSeconds": 60 }
    }
  },
  "Notifications": {
    "Channels": {
      "Email": { "Enabled": true, "Provider": "log" },
      "Sms": { "Enabled": false, "Provider": "" },
      "WhatsApp": { "Enabled": false, "Provider": "" },
      "InApp": { "Enabled": true }
    },
    "Providers": {}
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 10
  },
  "Api": {
    "Documentation": "Off",
    "UserRequestsPerMinute": 1200,
    "AnonymousRequestsPerMinute": 120,
    "AllowedOrigins": []
  },
  "Hangfire": {
    "Enabled": false,
    "ServerName": "base",
    "Queues": [ "default" ],
    "DashboardPath": "/jobs"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/base-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Observability": {
    "TraceUrlTemplate": null,
    "LogSearchUrlTemplate": null
  },
  "AllowedHosts": "*"
}
