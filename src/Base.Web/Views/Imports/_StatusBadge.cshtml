@model Base.Domain.DataExchange.ImportStatus
@using Base.Domain.DataExchange
@{
    var (tone, label) = Model switch
    {
        ImportStatus.Completed => ("success", "Completed"),
        ImportStatus.Validated => ("info", "Ready to apply"),
        ImportStatus.Invalid => ("danger", "Has errors"),
        ImportStatus.Failed => ("danger", "Failed"),
        ImportStatus.CompletedWithErrors => ("warning", "Completed with errors"),
        ImportStatus.Queued or ImportStatus.Running => ("info", Model.ToString()),
        _ => ("secondary", Model.ToString()),
    };
}
<span class="badge text-bg-@tone">@label</span>
