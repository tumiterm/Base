@model IReadOnlyList<Base.Application.Operations.ErrorRecord>
@if (Model.Count == 0)
{
    <p class="small text-muted mt-2">No errors recorded.</p>
}
else
{
    <table class="table table-sm align-top mt-2">
        <thead><tr><th>Ticket</th><th>When</th><th>Error</th><th>Request</th><th>User</th></tr></thead>
        <tbody>
            @foreach (var error in Model)
            {
                <tr>
                    <td class="text-nowrap"><a asp-action="Error" asp-route-ticket="@error.Ticket">@error.Ticket</a></td>
                    <td class="small text-nowrap"><local-time value="@error.OccurredAt" /></td>
                    <td class="small text-break">@error.ExceptionType.Split('.')[^1]<div class="text-muted">@error.Message</div></td>
                    <td class="small text-break">@error.Method @error.Path</td>
                    <td class="small">@error.User</td>
                </tr>
            }
        </tbody>
    </table>
}
