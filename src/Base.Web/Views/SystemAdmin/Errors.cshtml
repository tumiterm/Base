@model ErrorListViewModel
@{
    ViewData["Title"] = "Errors";
    var results = Model.Errors;
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">System</a><icon name="chevron-right" class="icon-sm" /><span aria-current="page">Errors</span></nav>
<div class="page-header">
    <div>
        <h1 class="page-title">Errors</h1>
        <p class="page-subtitle">Every unhandled error, by the ticket number the user saw. Search by ticket, exception or message.</p>
    </div>
</div>
<div class="toolbar">
    <span class="text-muted small">@results.Total.ToString("N0") recorded</span>
    <span class="toolbar-spacer"></span>
    <form method="get" class="toolbar-search" role="search">
        <label class="input-affix">
            <icon name="search" class="icon-sm" />
            <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="E-…, exception type or message" aria-label="Search errors" />
        </label>
    </form>
</div>
<section class="panel">
    <partial name="_ErrorTable" model="results.Items" />
</section>
@if (results.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">Page @results.Page of @results.TotalPages</span>
        <nav class="btn-group btn-group-sm" aria-label="Pages">
            <a class="btn btn-outline-secondary @(results.HasPrevious ? "" : "disabled")" asp-route-page="@(results.Page - 1)" asp-route-search="@Model.Search">Previous</a>
            <a class="btn btn-outline-secondary @(results.HasNext ? "" : "disabled")" asp-route-page="@(results.Page + 1)" asp-route-search="@Model.Search">Next</a>
        </nav>
    </div>
}
