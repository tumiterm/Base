@model ErrorListViewModel
@{
    ViewData["Title"] = "Errors";
    var results = Model.Errors;
}
<nav class="mb-2"><a asp-action="Index">&larr; System</a></nav>
<h1 class="h3 mb-3">Errors</h1>
<form method="get" class="mb-3" role="search">
    <div class="input-group">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Ticket (E-...), exception type or message" aria-label="Search errors" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>
<partial name="_ErrorTable" model="results.Items" />
@if (results.Total > 0)
{
    <nav class="d-flex justify-content-between">
        <span class="text-muted small">@results.Total error(s), page @results.Page of @results.TotalPages</span>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(results.HasPrevious ? "" : "disabled")" asp-route-page="@(results.Page - 1)" asp-route-search="@Model.Search">Previous</a>
            <a class="btn btn-outline-secondary btn-sm @(results.HasNext ? "" : "disabled")" asp-route-page="@(results.Page + 1)" asp-route-search="@Model.Search">Next</a>
        </div>
    </nav>
}
