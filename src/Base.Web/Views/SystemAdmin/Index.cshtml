@model SystemViewModel
@inject TimeProvider Time
@inject Microsoft.Extensions.Options.IOptions<Base.Infrastructure.Jobs.HangfireOptions> Hangfire
@{
    ViewData["Title"] = "System";
    var now = Time.GetUtcNow();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">System <partial name="_HealthBadge" model="Model.Health.State" /></h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Errors">Errors</a>
        @if (Hangfire.Value.Enabled)
        {
            <a class="btn btn-outline-secondary" href="@Url.Content("~" + Hangfire.Value.DashboardPath)" asp-permission="@PermissionCodes.System.JobsManage">Hangfire</a>
        }
    </div>
</div>

<h2 class="h5">Health</h2>
<p class="small text-muted">Checked just now in @Model.Health.Duration.TotalMilliseconds.ToString("N0") ms. <code>/health/ready</code> (for load balancers) only checks the database.</p>
<table class="table table-sm align-top mb-4">
    <thead><tr><th>Check</th><th>Status</th><th>Details</th><th class="text-end">Time</th></tr></thead>
    <tbody>
        @foreach (var check in Model.Health.Checks)
        {
            <tr>
                <td class="text-nowrap">@check.Name</td>
                <td><partial name="_HealthBadge" model="check.State" /></td>
                <td class="small">
                    @check.Description
                    @if (check.Data.Count > 0)
                    {
                        <div class="text-muted">@string.Join(" · ", check.Data.Select(d => $"{d.Key}: {d.Value}"))</div>
                    }
                </td>
                <td class="text-end small text-nowrap">@check.Duration.TotalMilliseconds.ToString("N0") ms</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5">Scheduled jobs</h2>
<table class="table table-sm align-middle mb-4">
    <thead><tr><th>Job</th><th>Last run</th><th>Result</th><th>Next</th><th></th></tr></thead>
    <tbody>
        @foreach (var job in Model.Jobs)
        {
            <tr class="@(job.NeedsAttention(now) ? "table-warning" : "")">
                <td>@job.Name<div class="small text-muted">@job.Description (@Every(job.Interval))</div></td>
                <td class="small text-nowrap">
                    @if (job.LastRun is { } run) { <local-time value="@run.StartedAt" /><div class="text-muted">@run.Duration.TotalSeconds.ToString("N1") s</div> } else { <span class="text-muted">not yet</span> }
                </td>
                <td class="small">
                    @if (job.IsRunning) { <span class="badge text-bg-info">running</span> }
                    else if (job.LastRun is { } last) { <span class="badge @(last.Succeeded ? "text-bg-success" : "text-bg-danger")">@(last.Succeeded ? "OK" : "Failed")</span> <span>@last.Message</span> }
                </td>
                <td class="small text-nowrap">@if (job.NextRunAt is { } next) { <local-time value="@next" /> }</td>
                <td>
                    <form asp-action="RunJob" asp-route-code="@job.Code" method="post" asp-permission="@PermissionCodes.System.JobsManage">
                        <button class="btn btn-sm btn-outline-secondary text-nowrap" type="submit" disabled="@job.IsRunning">Run now</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <h2 class="h5">Database</h2>
        <p class="small mb-2">Data @Mb(Model.Database.DataMb) · Log @Mb(Model.Database.LogMb)</p>
        @if (Model.Database.LargestTables.Count == 0)
        {
            <p class="small text-muted">Table sizes need the VIEW DATABASE STATE permission.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>Largest tables</th><th class="text-end">Rows</th><th class="text-end">Size</th></tr></thead>
                <tbody>
                    @foreach (var table in Model.Database.LargestTables)
                    {
                        <tr><td class="small">@table.Table</td><td class="text-end small">@table.Rows.ToString("N0")</td><td class="text-end small">@Mb(table.ReservedMb)</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="col-lg-6">
        <h2 class="h5">File storage</h2>
        @if (Model.Storage.Count == 0)
        {
            <p class="small text-muted">No files stored yet.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>Tenant</th><th>Provider</th><th class="text-end">Files</th><th class="text-end">Size</th></tr></thead>
                <tbody>
                    @foreach (var usage in Model.Storage)
                    {
                        <tr>
                            <td class="small">@usage.Tenant</td>
                            <td class="small">@usage.Provider</td>
                            <td class="text-end small">@usage.Files.ToString("N0")@if (usage.DeletedFiles > 0) { <div class="text-muted">+@usage.DeletedFiles deleted</div> }</td>
                            <td class="text-end small">@Size(usage.Bytes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<h2 class="h5">Outbox</h2>
<p class="small">@Model.Outbox.Pending pending@(Model.Outbox.OldestPendingAge is { } age ? $", oldest {age.TotalMinutes:N0} min" : "") · @Model.Outbox.DeadLettered dead-lettered</p>
@if (Model.Outbox.DeadLetters.Count > 0)
{
    <table class="table table-sm align-top mb-4">
        <thead><tr><th>Event</th><th>Raised</th><th>Attempts</th><th>Last error</th><th></th></tr></thead>
        <tbody>
            @foreach (var message in Model.Outbox.DeadLetters)
            {
                <tr>
                    <td class="small">@message.Type</td>
                    <td class="small text-nowrap"><local-time value="@message.OccurredAt" /></td>
                    <td class="small">@message.Attempts</td>
                    <td class="small text-break text-danger">@message.LastError</td>
                    <td>
                        <form asp-action="RetryOutbox" asp-route-id="@message.Id" method="post" asp-permission="@PermissionCodes.System.JobsManage">
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Retry</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="d-flex justify-content-between align-items-center">
    <h2 class="h5 mb-0">Recent errors</h2>
    <a asp-action="Errors" class="small">All errors (@Model.RecentErrors.Total)</a>
</div>
<partial name="_ErrorTable" model="Model.RecentErrors.Items" />
@functions {
    private static string Mb(decimal? value) => value is null ? "n/a" : $"{value:N1} MB";

    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:N1} MB" : $"{bytes / 1024.0:N0} KB";

    private static string Every(TimeSpan interval) => interval.TotalDays >= 1 ? $"every {interval.TotalDays:0} day(s)" : $"every {interval.TotalHours:0} hour(s)";
}
