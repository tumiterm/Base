@model ErrorDetailsViewModel
@{
    var error = Model.Error;
    ViewData["Title"] = error.Ticket;
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">System</a><icon name="chevron-right" class="icon-sm" /><a asp-action="Errors">Errors</a><icon name="chevron-right" class="icon-sm" /><span aria-current="page">@error.Ticket</span></nav>
<div class="page-header">
    <div class="entity">
        <span class="file-tile file-tile-lg is-pdf" aria-hidden="true"><icon name="circle-alert" /></span>
        <div class="entity-text">
            <h1 class="page-title mono">@error.Ticket</h1>
            <p class="page-subtitle">@error.ExceptionType.Split('.')[^1] · <local-time value="error.OccurredAt" format="d MMM yyyy, HH:mm:ss" /></p>
        </div>
    </div>
    <div class="page-actions">
        @if (Model.TraceUrl is { } trace) {<a class="btn btn-secondary" href="@trace" target="_blank" rel="noopener"><icon name="activity" class="icon-sm" /> Open the trace</a>}
        @if (Model.LogSearchUrl is { } logs) {<a class="btn btn-secondary" href="@logs" target="_blank" rel="noopener"><icon name="search" class="icon-sm" /> Search the logs</a>}
        <button class="btn btn-ghost" type="button" data-copy="#error-details"><icon name="copy" class="icon-sm" /> <span data-copy-label>Copy details</span></button>
    </div>
</div>
<div class="detail-grid">
    <section class="panel" aria-labelledby="stack-title">
        <div class="panel-header"><h2 class="panel-title" id="stack-title">What happened</h2></div>
        <div class="panel-body"><p class="mb-0 fw-semibold">@error.Message</p></div>
        <pre class="code-block" id="error-details">@error.Details</pre>
    </section>
    <aside class="stack">
        <section class="panel" aria-labelledby="context-title">
            <div class="panel-header"><h2 class="panel-title" id="context-title">Context</h2></div>
            <div class="panel-body">
                <dl class="kv">
                    <dt>Request</dt><dd class="mono">@error.Method @error.Path</dd>
                    <dt>User</dt><dd>@(error.User ?? "Anonymous")</dd>
                    <dt>Exception</dt><dd class="mono">@error.ExceptionType</dd>
                    <dt>Trace id</dt><dd class="mono">@(error.TraceId ?? "—")</dd>
                    <dt>Fingerprint</dt><dd class="mono">@error.Fingerprint</dd>
                </dl>
            </div>
            <div class="panel-footer small text-muted">The same exception thrown from the same place has the same fingerprint, so repeats are easy to group.</div>
        </section>
    </aside>
</div>
