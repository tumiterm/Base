@model Base.Application.Operations.HealthState
@{
    var (tone, label) = Model switch
    {
        Base.Application.Operations.HealthState.Healthy => ("success", "Healthy"),
        Base.Application.Operations.HealthState.Degraded => ("warning", "Degraded"),
        _ => ("danger", "Unhealthy"),
    };
}
<span class="badge text-bg-@tone">@label</span>
