@model DocumentListViewModel
@using Base.Application.Documents
@using Base.Application.Files
@using Base.Domain.Documents
@{
    ViewData["Title"] = "Documents";
    var results = Model.Documents;
    var f = Model.Filter;
    var filtered = !string.IsNullOrEmpty(f.Search) || f.Type is not null || f.Tag is not null;
    var statuses = new (DocumentStatus? Status, string Label)[] { (null, "Current"), (DocumentStatus.Draft, "Drafts"), (DocumentStatus.Final, "Final"), (DocumentStatus.Archived, "Archived") };
}
@functions {
    private object Route(DocumentListViewModel m, DocumentStatus? status = null, bool keepStatus = true, string? tag = "", int page = 1) => new
    {
        search = m.Filter.Search,
        type = m.Filter.Type,
        tag = tag == "" ? m.Filter.Tag : tag,
        status = keepStatus ? m.Filter.Status : status,
        page,
    };
}
<div class="page-header">
    <div>
        <h1 class="page-title">Documents</h1>
        <p class="page-subtitle">Contracts, letters and files, versioned and linked to the records they belong to.</p>
    </div>
    <div class="page-actions">
        <partial name="_ExportButtons" model='new ExportButtonsViewModel("documents", PermissionCodes.Documents.Create)' />
        @if (Model.CanCreate)
        {
            <a class="btn btn-secondary" asp-action="Generate" asp-feature="@FeatureCodes.DocumentGeneration"><icon name="sparkles" class="icon-sm" /> From a template</a>
            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#upload-document" aria-controls="upload-document"><icon name="upload" class="icon-sm" /> Upload</button>
        }
    </div>
</div>

<div class="toolbar">
    <nav class="segmented scroll-x" aria-label="Filter by status">
        @foreach (var s in statuses)
        {
            var active = s.Status == f.Status;
            <a class="@(active ? "is-active" : "")" aria-current="@(active ? "page" : null)" href="@Url.Action("Index", Route(Model, s.Status, keepStatus: false))">@s.Label</a>
        }
    </nav>
    <span class="toolbar-spacer"></span>
    <form method="get" class="d-flex flex-wrap gap-2 toolbar-search" role="search">
        <input type="hidden" name="status" value="@f.Status" />
        <input type="hidden" name="tag" value="@f.Tag" />
        <select class="form-select w-auto" name="type" aria-label="Type" data-autosubmit>
            <option value="">All types</option>
            @foreach (var t in DocumentTypeCatalog.All) {<option value="@t.Code" selected="@(t.Code == f.Type)">@t.Name</option>}
        </select>
        <label class="input-affix flex-grow-1">
            <icon name="search" class="icon-sm" />
            <input class="form-control" type="search" name="search" value="@f.Search" placeholder="Search titles" aria-label="Search documents" />
        </label>
    </form>
</div>

@if (f.Tag is not null)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="text-muted small">Tagged</span>
        <a class="chip is-active" href="@Url.Action("Index", Route(Model, tag: null))" aria-label="Remove the tag filter"><icon name="tag" /> @f.Tag <icon name="x" /></a>
    </div>
}

@if (results.Total == 0)
{
    <div class="empty-state">
        <icon name="file-text" />
        <div class="empty-state-title">@(filtered || f.Status is not null ? "No documents match" : "No documents yet")</div>
        <p class="mb-2">@(filtered || f.Status is not null ? "Try another search, type or status." : "Upload a file, or generate a letter or contract from a template.")</p>
        @if (filtered || f.Status is not null)
        {
            <a class="btn btn-secondary" asp-action="Index">Clear filters</a>
        }
        else if (Model.CanCreate)
        {
            <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#upload-document"><icon name="upload" class="icon-sm" /> Upload a document</button>
        }
    </div>
}
else
{
    <table class="table table-entity align-middle">
        <thead>
            <tr>
                <th>Document</th>
                <th>Type</th>
                <th>Linked to</th>
                <th>Status</th>
                <th>Updated</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in results.Items)
            {
                var link = Model.LinkOf(d);
                var kind = Model.PreviewEnabled ? FilePreviews.KindOf(d.ContentType) : PreviewKind.None;
                <tr>
                    <td>
                        <a class="entity text-decoration-none" asp-action="Details" asp-route-id="@d.Id">
                            <span class="file-tile @FileDisplay.TileClass(d.ContentType, d.FileName)" aria-hidden="true"><icon name="@FileDisplay.Icon(d.ContentType, d.FileName)" /></span>
                            <span class="entity-text">
                                <span class="entity-name">@d.Title</span>
                                <span class="entity-sub">@(d.FileName is null ? "No file yet" : $"{FileDisplay.Describe(d.ContentType, d.FileName)} · {FileDisplay.Size(d.SizeBytes)} · v{d.CurrentVersion}")</span>
                            </span>
                        </a>
                        @if (d.Tags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var tag in d.Tags.Take(3)) {<a class="chip" href="@Url.Action("Index", Route(Model, tag: tag))">@tag</a>}
                                @if (d.Tags.Count > 3) {<span class="chip">+@(d.Tags.Count - 3)</span>}
                            </div>
                        }
                    </td>
                    <td>@(DocumentTypeCatalog.Find(d.DocumentType)?.Name ?? d.DocumentType)</td>
                    <td>@if (link is not null) {<partial name="_RecordLink" model="link" />} else {<span class="text-muted">—</span>}</td>
                    <td><span class="badge text-bg-@FileDisplay.Tone(d.Status)">@FileDisplay.Status(d.Status)</span></td>
                    <td class="text-muted text-nowrap"><local-time value="d.DateModified" format="d MMM yyyy" /></td>
                    <td class="text-end cell-actions">
                        <div class="row-actions">
                            @if (kind != PreviewKind.None)
                            {
                                <button class="icon-btn" type="button" title="Preview" aria-label="Preview @d.Title"
                                        data-preview="@kind.ToString().ToLowerInvariant()"
                                        data-preview-src="@Url.Action("Preview", new { id = d.Id })"
                                        data-preview-name="@d.Title"
                                        data-preview-filename="@d.FileName · @FileDisplay.Size(d.SizeBytes)"
                                        data-preview-icon="@FileDisplay.Icon(d.ContentType, d.FileName)"
                                        data-preview-tone="@FileDisplay.TileClass(d.ContentType, d.FileName)"
                                        data-preview-download-url="@Url.Action("Download", new { id = d.Id })"
                                        data-preview-open-url="@Url.Action("Details", new { id = d.Id })"><icon name="eye" /></button>
                            }
                            else
                            {
                                <span class="icon-btn invisible" aria-hidden="true"></span>
                            }
                            <div class="dropdown">
                                <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @d.Title"><icon name="ellipsis" /></button>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a class="dropdown-item" asp-action="Details" asp-route-id="@d.Id"><icon name="external-link" class="icon-sm" /> Open</a>
                                    @if (d.FileName is not null)
                                    {
                                        <a class="dropdown-item" asp-action="Download" asp-route-id="@d.Id"><icon name="download" class="icon-sm" /> Download</a>
                                    }
                                    @if (link is not null && RecordLinks.Url(Url, link) is { } recordUrl)
                                    {
                                        <a class="dropdown-item" href="@recordUrl"><icon name="@RecordLinks.Icon(link.Ref.EntityType)" class="icon-sm" /> Go to @link.TypeName.ToLowerInvariant()</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">@results.Total document@(results.Total == 1 ? "" : "s") · page @results.Page of @results.TotalPages</span>
        <nav class="btn-group btn-group-sm" aria-label="Pages">
            <a class="btn btn-outline-secondary @(results.HasPrevious ? "" : "disabled")" href="@Url.Action("Index", Route(Model, page: results.Page - 1))">Previous</a>
            <a class="btn btn-outline-secondary @(results.HasNext ? "" : "disabled")" href="@Url.Action("Index", Route(Model, page: results.Page + 1))">Next</a>
        </nav>
    </div>
}

<partial name="_PreviewDrawer" />
@if (Model.CanCreate)
{
    <partial name="_UploadDrawer" model='new UploadDrawerViewModel("upload-document")' />
}
