@model (string? LinkType, string? LinkId, string? ReturnUrl)
@using Base.Application.Documents
<form asp-controller="Documents" asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body mb-3">
    <input type="hidden" name="LinkType" value="@Model.LinkType" />
    <input type="hidden" name="LinkId" value="@Model.LinkId" />
    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
    <div class="drop-zone mb-3">
        <input class="form-control" type="file" name="File" id="upload-file" required />
        <div class="drop-zone-hint small text-muted">or drop a file here</div>
    </div>
    <div class="row g-2">
        <div class="col-md-5"><label class="form-label small" for="upload-title">Title</label><input class="form-control" id="upload-title" name="Title" maxlength="200" required /></div>
        <div class="col-md-3">
            <label class="form-label small" for="upload-type">Type</label>
            <select class="form-select" id="upload-type" name="Type">
                @foreach (var t in DocumentTypeCatalog.All) { <option value="@t.Code">@t.Name</option> }
            </select>
        </div>
        <div class="col-md-4"><label class="form-label small" for="upload-tags">Tags</label><input class="form-control" id="upload-tags" name="Tags" placeholder="comma, separated" /></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary" type="submit">Upload</button></div>
</form>
