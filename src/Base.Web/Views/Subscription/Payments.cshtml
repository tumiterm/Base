@model Base.Application.Common.Persistence.PagedResult<Base.Application.Payments.PaymentView>
@{
    ViewData["Title"] = "Payment history";
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">Subscription</a><icon name="chevron-right" class="icon-sm" /><span aria-current="page">Payment history</span></nav>
<div class="page-header">
    <div>
        <h1 class="page-title">Billing</h1>
        <p class="page-subtitle">Every payment for this organisation's subscription, newest first.</p>
    </div>
</div>
<partial name="_BillingTabs" model="@("payments")" />
@if (Model.Items.Count == 0)
{
    <div class="empty-state"><icon name="receipt" /><div class="empty-state-title">No payments yet</div></div>
}
else
{
    <table class="table table-entity align-middle">
        <thead><tr><th>Payment</th><th>Reference</th><th>Paid with</th><th>Date</th><th class="text-end">Amount</th><th>Status</th><th><span class="visually-hidden">Invoice</span></th></tr></thead>
        <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td>
                        <a class="entity text-decoration-none" asp-action="Payment" asp-route-reference="@p.Reference">
                            <span class="file-tile" aria-hidden="true"><icon name="@(p.IsRenewal ? "refresh-cw" : p.IsUpgrade ? "arrow-up-right" : "receipt")" /></span>
                            <span class="entity-text">
                                <span class="entity-name">@p.Description</span>
                                <span class="entity-sub">@(p.IsRenewal ? "Automatic renewal" : "By " + p.RequestedByName)@(p.SetsUpRenewal ? " · set up automatic renewal" : "")@(p.IsUpgrade ? " · upgrade" : "")</span>
                            </span>
                        </a>
                    </td>
                    <td class="mono small">@p.Reference</td>
                    <td>@p.GatewayName</td>
                    <td class="text-muted text-nowrap"><local-time value="p.CreatedAt" format="d MMM yyyy, HH:mm" /></td>
                    <td class="text-end fw-semibold text-nowrap">@Display.Money(p.Amount, p.Currency)</td>
                    <td><span class="badge text-bg-@Display.Tone(p.Status)">@Display.Status(p.Status)</span></td>
                    <td class="text-end cell-actions">@if (p.Status == Base.Domain.Payments.PaymentStatus.Succeeded) {<a class="btn btn-ghost btn-sm" asp-action="PaymentInvoice" asp-route-reference="@p.Reference"><icon name="file-text" class="icon-sm" /> Invoice</a>}</td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">Page @Model.Page of @Model.TotalPages</span>
            <nav class="btn-group btn-group-sm" aria-label="Pages">
                <a class="btn btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")" asp-route-page="@(Model.Page - 1)">Previous</a>
                <a class="btn btn-outline-secondary @(Model.HasNext ? "" : "disabled")" asp-route-page="@(Model.Page + 1)">Next</a>
            </nav>
        </div>
    }
}
