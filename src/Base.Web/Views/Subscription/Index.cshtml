@model SubscriptionPageViewModel
@inject ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Subscription";
    var s = Model.Mine.Subscription;
    var canView = CurrentUser.HasPermission(PermissionCodes.Subscription.View);
    var payable = Model.CanPay && Model.Gateways.Count > 0 && Model.Mine.Plans.Count > 0;
}
<div class="page-header">
    <div>
        <h1 class="page-title">Subscription</h1>
        <p class="page-subtitle">Your organisation's plan, what it includes, and how much of it is in use.</p>
    </div>
    @if (canView && Model.Payments.Count > 0)
    {
        <div class="page-actions"><a class="btn btn-secondary" asp-action="Payments"><icon name="receipt" class="icon-sm" /> Payment history</a></div>
    }
</div>

@if (!Model.Access.HasAccess && s is not null)
{
    <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
        <icon name="circle-alert" />
        <div>
            <strong>Access is paused: the subscription is @Display.Status(s.Status).ToLowerInvariant().</strong>
            <div>@(s.StatusReason ?? "Contact us to restore access.") Your data is kept and access returns as soon as the subscription is active@(payable ? ": choose a plan below to pay and restore it now" : "").</div>
        </div>
    </div>
}

@if (s is null)
{
    <div class="empty-state">
        <icon name="sparkles" />
        <div class="empty-state-title">No subscription needed</div>
        <p class="mb-0">This organisation isn't on a plan, so every feature is on and nothing is limited.</p>
    </div>
}
else if (!canView)
{
    <div class="panel"><div class="panel-body d-flex align-items-center justify-content-between gap-3">
        <div><div class="fw-semibold">@s.PlanName</div><div class="text-muted small">Ask an administrator for details.</div></div>
        <partial name="_SubscriptionStatus" model="s.Status" />
    </div></div>
}
else
{
    <div class="detail-grid">
        <div class="stack">
            <section class="panel" aria-labelledby="plan-title">
                <div class="panel-header">
                    <h2 class="panel-title" id="plan-title">@s.PlanName</h2>
                    <partial name="_SubscriptionStatus" model="s.Status" />
                </div>
                <div class="panel-body stack">
                    <dl class="fact-row">
                        <div><dt>Price</dt><dd>@Display.Money(s.Price, s.Currency)<small>@Display.PerCycle(s.BillingCycle)</small></dd></div>
                        @if (s.Status == SubscriptionStatus.Trialing)
                        {
                            <div><dt>Trial ends</dt><dd><local-time value="s.CurrentPeriodEnd" format="d MMM yyyy" /></dd></div>
                        }
                        else if (s.HasAccess)
                        {
                            <div><dt>@(s.CancelAtPeriodEnd ? "Ends" : s.Status == SubscriptionStatus.PastDue ? "Was due" : "Paid up to")</dt><dd><local-time value="s.CurrentPeriodEnd" format="d MMM yyyy" /></dd></div>
                        }
                        <div><dt>Billing</dt><dd>@s.BillingCycle</dd></div>
                        <div><dt>Member since</dt><dd><local-time value="s.StartedAt" format="d MMM yyyy" /></dd></div>
                    </dl>
                    @if (s.StatusReason is not null) {<p class="text-muted small mb-0"><icon name="info" class="icon-sm" /> @s.StatusReason</p>}

                    @if (s.Scheduled is { } next)
                    {
                        <div class="status-callout is-warning">
                            <icon name="calendar" />
                            <div class="flex-grow-1">
                                <div class="status-callout-title">Moving to @next.PlanName on <local-time value="next.At" format="d MMMM yyyy" /></div>
                                <div class="small">@Display.Money(next.Price, next.Currency)@Display.PerCycle(next.BillingCycle) from then. Until that date you keep @s.PlanName, but can't add more than @next.PlanName allows.</div>
                            </div>
                            @if (Model.CanPay)
                            {
                                <form method="post" asp-action="KeepPlan"><button type="submit" class="btn btn-secondary btn-sm">Keep @s.PlanName</button></form>
                            }
                        </div>
                    }

                    @if (Model.Recurring is { } r)
                    {
                        var active = r.Status == Base.Domain.Payments.RecurringPaymentStatus.Active;
                        <div class="renewal-row" id="renewal">
                            <icon name="refresh-cw" />
                            <div class="flex-grow-1">
                                <div class="fw-semibold">Automatic renewal <span class="badge text-bg-@(active ? "success" : "info") ms-1">@(active ? "On" : "Starting")</span></div>
                                <div class="small text-muted">
                                    @if (active)
                                    {
                                        <text>@Display.Money(r.Amount, r.Currency) every @(r.BillingCycle == BillingCycle.Annual ? "year" : "month") for @r.PlanName through @r.GatewayName@(r.LastChargedAt is { } last ? "; last charged " : "")@if (r.LastChargedAt is { } lastCharged) {<local-time value="lastCharged" format="d MMM yyyy" />}.</text>
                                    }
                                    else
                                    {
                                        <text>Through @r.GatewayName, once your first payment is confirmed.</text>
                                    }
                                </div>
                                @if (r.StopError is not null) {<div class="small text-warning mt-1">@r.StopError</div>}
                            </div>
                            @if (Model.CanPay && active)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @if (r.CanUpdateCard) {<form method="post" asp-action="UpdateCard" asp-route-id="@r.Id"><button type="submit" class="btn btn-secondary btn-sm">Update card</button></form>}
                                    @if (r.Gateway == "Test") {<form method="post" asp-controller="TestCheckout" asp-action="Renew"><button type="submit" class="btn btn-secondary btn-sm">Simulate the next charge</button></form>}
                                    <form method="post" asp-action="StopRenewal" asp-route-id="@r.Id"><button type="submit" class="btn btn-ghost btn-sm text-danger">Turn off</button></form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>

            @if (Model.Mine.Plans.Count > 0)
            {
                <form method="post" asp-action="Review" class="panel" id="pay" aria-labelledby="plans-title">
                    <div class="panel-header flex-wrap gap-2">
                        <h2 class="panel-title" id="plans-title">Plans</h2>
                        @if (payable)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 ms-auto">
                                <div class="segmented" role="radiogroup" aria-label="Billing cycle">
                                    <input type="radio" name="BillingCycle" id="pay-monthly" value="Monthly" checked="@(s.BillingCycle == BillingCycle.Monthly)" /><label for="pay-monthly">Monthly</label>
                                    <input type="radio" name="BillingCycle" id="pay-annual" value="Annual" checked="@(s.BillingCycle == BillingCycle.Annual)" /><label for="pay-annual">Yearly</label>
                                </div>
                                <button type="submit" class="btn btn-primary">Continue <icon name="arrow-right" class="icon-sm" /></button>
                            </div>
                        }
                    </div>
                    <div class="panel-body">
                        <div class="plan-grid" role="@(payable ? "radiogroup" : null)" aria-label="Plan">
                            @foreach (var plan in Model.Mine.Plans)
                            {
                                var current = plan.Id == s.PlanId;
                                <label class="choice-card @(current ? "is-current" : "")">
                                    @if (payable) {<input type="radio" name="PlanId" value="@plan.Id" checked="@current" /><span class="choice-check"><icon name="check" /></span>}
                                    <span class="choice-title">@plan.Name @if (current) {<span class="badge text-bg-primary ms-1">Your plan</span>}</span>
                                    <span class="choice-price">@Display.Money(plan.MonthlyPrice, plan.Currency) <small>/month</small></span>
                                    <span class="choice-desc">or @Display.Money(plan.AnnualPrice, plan.Currency) /year</span>
                                    @if (payable && Model.Changes?.GetValueOrDefault(plan.Id) is { } change)
                                    {
                                        <span class="choice-note">
                                            @switch (change.Kind)
                                            {
                                                case PlanChangeKind.Upgrade:
                                                    <text><icon name="arrow-up-right" class="icon-sm" /> Starts today: pay @Display.Money(change.AmountDueNow, change.Currency) now, the difference</text>
                                                    break;
                                                case PlanChangeKind.AtPeriodEnd:
                                                    <text><icon name="calendar" class="icon-sm" /> Starts <local-time value="change.EffectiveAt" format="d MMM yyyy" />: nothing to pay today</text>
                                                    break;
                                                case PlanChangeKind.Extend when change.RenewsAutomatically:
                                                    <text><icon name="circle-check" class="icon-sm" /> Renews automatically on <local-time value="change.PeriodEnd" format="d MMM yyyy" /></text>
                                                    break;
                                                case PlanChangeKind.Extend:
                                                    <text><icon name="circle-check" class="icon-sm" /> Paid up to <local-time value="change.PeriodEnd" format="d MMM yyyy" />. You can pay ahead</text>
                                                    break;
                                                default:
                                                    <text><icon name="credit-card" class="icon-sm" /> Starts today: pay @Display.Money(change.AmountDueNow, change.Currency)</text>
                                                    break;
                                            }
                                        </span>
                                    }
                                    @if (plan.Description is not null) {<span class="choice-desc">@plan.Description</span>}
                                    <details class="plan-details">
                                        <summary>What's included</summary>
                                        <partial name="_PlanFeatures" model="plan" />
                                    </details>
                                </label>
                            }
                        </div>
                        @if (!payable)
                        {
                            <p class="text-muted small mt-3 mb-0">@(Model.CanPay ? "Online payment isn't set up yet. To pay or change plan, contact us." : "To change plan, ask an administrator.")</p>
                        }
                    </div>
                    @if (payable)
                    {
                        <div class="panel-footer text-muted small">
                            @if (s.Status == SubscriptionStatus.Active)
                            {
                                <text>A dearer plan starts today and you pay only the difference. A cheaper plan, or another billing cycle, starts when your paid period ends. You choose how to pay on the next page.</text>
                            }
                            else
                            {
                                <text>Paying starts a fresh period on the plan you choose, from today. You choose how to pay on the next page.</text>
                            }
                        </div>
                    }
                </form>
            }
        </div>

        <div class="stack">
            <section class="panel" aria-labelledby="usage-title">
                <div class="panel-header"><h2 class="panel-title" id="usage-title">Usage</h2></div>
                <div class="panel-body"><partial name="_UsageMeters" model="Model.Mine.Usage" /></div>
            </section>

            @if (Model.Payments.Count > 0)
            {
                <section class="panel" aria-labelledby="payments-title">
                    <div class="panel-header"><h2 class="panel-title" id="payments-title">Recent payments</h2><a class="small" asp-action="Payments">See all</a></div>
                    <ul class="item-list">
                        @foreach (var p in Model.Payments.Take(3))
                        {
                            <li>
                                <a class="item-main text-decoration-none" asp-action="Payment" asp-route-reference="@p.Reference">
                                    <div class="item-title">@p.Description</div>
                                    <div class="item-sub"><local-time value="p.CreatedAt" format="d MMM yyyy" /> · @p.GatewayName</div>
                                </a>
                                <div class="item-aside text-end">
                                    <div class="fw-semibold">@Display.Money(p.Amount, p.Currency)</div>
                                    <span class="badge text-bg-@Display.Tone(p.Status)">@Display.Status(p.Status)</span>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
}
