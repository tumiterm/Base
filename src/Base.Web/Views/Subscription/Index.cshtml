@model SubscriptionPageViewModel
@inject ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Subscription";
    var s = Model.Mine.Subscription;
    var canView = CurrentUser.HasPermission(PermissionCodes.Subscription.View);
    var payable = Model.CanPay && Model.Gateways.Count > 0 && Model.Mine.Plans.Count > 0;
}
<div class="page-header">
    <div>
        <h1 class="page-title">Subscription</h1>
        <p class="page-subtitle">Your organisation's plan, what it includes, and how much of it is in use.</p>
    </div>
</div>

@if (!Model.Access.HasAccess && s is not null)
{
    <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
        <icon name="circle-alert" />
        <div>
            <strong>Access is paused: the subscription is @Display.Status(s.Status).ToLowerInvariant().</strong>
            <div>@(s.StatusReason ?? "Contact us to restore access.") Your data is kept and access returns as soon as the subscription is active@(Model.CanPay && Model.Gateways.Count > 0 ? ": pay below to restore it now" : "").</div>
        </div>
    </div>
}

@if (s is null)
{
    <div class="empty-state">
        <icon name="sparkles" />
        <div class="empty-state-title">No subscription needed</div>
        <p class="mb-0">This organisation isn't on a plan, so every feature is on and nothing is limited.</p>
    </div>
}
else if (!canView)
{
    <div class="panel"><div class="panel-body d-flex align-items-center justify-content-between gap-3">
        <div><div class="fw-semibold">@s.PlanName</div><div class="text-muted small">Ask an administrator for details.</div></div>
        <partial name="_SubscriptionStatus" model="s.Status" />
    </div></div>
}
else
{
    <div class="detail-grid">
        <div class="stack">
            <section class="panel" aria-labelledby="plan-title">
                <div class="panel-header">
                    <h2 class="panel-title" id="plan-title">Current plan</h2>
                    <partial name="_SubscriptionStatus" model="s.Status" />
                </div>
                <div class="panel-body">
                    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
                        <div class="h4 mb-0">@s.PlanName</div>
                        <div class="choice-price">@Display.Money(s.Price, s.Currency) <small>@Display.PerCycle(s.BillingCycle)</small></div>
                    </div>
                    <dl class="kv">
                        @if (s.Status == SubscriptionStatus.Trialing)
                        {
                            <dt>Trial ends</dt><dd><local-time value="s.CurrentPeriodEnd" format="d MMMM yyyy" /></dd>
                        }
                        else if (s.HasAccess)
                        {
                            <dt>@(s.CancelAtPeriodEnd ? "Ends" : s.Status == SubscriptionStatus.PastDue ? "Was due" : "Renews")</dt><dd><local-time value="s.CurrentPeriodEnd" format="d MMMM yyyy" /></dd>
                        }
                        <dt>Billing</dt><dd>@s.BillingCycle</dd>
                        <dt>Member since</dt><dd><local-time value="s.StartedAt" format="d MMMM yyyy" /></dd>
                        @if (s.StatusReason is not null) {<dt>Note</dt><dd>@s.StatusReason</dd>}
                    </dl>
                    @if (s.Scheduled is { } next)
                    {
                        <div class="status-callout is-warning mt-3">
                            <icon name="calendar" />
                            <div class="flex-grow-1">
                                <div class="status-callout-title">Moving to @next.PlanName on <local-time value="next.At" format="d MMMM yyyy" /></div>
                                <div class="small">@Display.Money(next.Price, next.Currency)@Display.PerCycle(next.BillingCycle) from then. Until that date you keep @s.PlanName, but can't add more than @next.PlanName allows.</div>
                            </div>
                            @if (Model.CanPay)
                            {
                                <form method="post" asp-action="KeepPlan"><button type="submit" class="btn btn-secondary btn-sm">Keep @s.PlanName</button></form>
                            }
                        </div>
                    }
                </div>
            </section>

            @if (Model.Recurring is { } r)
            {
                var active = r.Status == Base.Domain.Payments.RecurringPaymentStatus.Active;
                <section class="panel" id="renewal" aria-labelledby="renewal-title">
                    <div class="panel-header">
                        <h2 class="panel-title" id="renewal-title"><icon name="refresh-cw" class="icon-sm" /> Automatic renewal</h2>
                        <span class="badge text-bg-@(active ? "success" : "info")">@(active ? "On" : "Starting")</span>
                    </div>
                    <div class="panel-body stack">
                        <p class="mb-0">
                            @if (active)
                            {
                                <text><strong>@Display.Money(r.Amount, r.Currency)</strong> every @(r.BillingCycle == BillingCycle.Annual ? "year" : "month") for @r.PlanName, charged by @r.GatewayName until you turn it off.</text>
                            }
                            else
                            {
                                <text>Automatic renewal through @r.GatewayName starts once your first payment is confirmed.</text>
                            }
                        </p>
                        @if (r.StopError is not null)
                        {
                            <div class="status-callout is-warning"><icon name="triangle-alert" /><div class="small">@r.StopError</div></div>
                        }
                        <dl class="kv mb-0">
                            <dt>Set up by</dt><dd>@r.StartedByName, <local-time value="r.StartedAt" format="d MMMM yyyy" /></dd>
                            @if (r.LastChargedAt is { } last) {<dt>Last charged</dt><dd><local-time value="last" format="d MMMM yyyy" /> (@r.Charges payment@(r.Charges == 1 ? "" : "s"))</dd>}
                        </dl>
                    </div>
                    @if (Model.CanPay && active)
                    {
                        <div class="panel-footer d-flex flex-wrap gap-2">
                            @if (r.CanUpdateCard)
                            {
                                <form method="post" asp-action="UpdateCard" asp-route-id="@r.Id"><button type="submit" class="btn btn-secondary"><icon name="credit-card" class="icon-sm" /> Update card</button></form>
                            }
                            @if (r.Gateway == "Test")
                            {
                                <form method="post" asp-controller="TestCheckout" asp-action="Renew"><button type="submit" class="btn btn-secondary"><icon name="refresh-cw" class="icon-sm" /> Simulate the next charge</button></form>
                            }
                            <form method="post" asp-action="StopRenewal" asp-route-id="@r.Id" class="ms-auto"><button type="submit" class="btn btn-outline-danger">Turn off automatic renewal</button></form>
                        </div>
                    }
                </section>
            }

            @if (payable)
            {
                <section class="panel" id="pay" aria-labelledby="pay-title">
                    <div class="panel-header">
                        <h2 class="panel-title" id="pay-title">@(s.Status is SubscriptionStatus.Active ? "Pay ahead or change plan" : "Pay online")</h2>
                        <span class="text-muted small"><icon name="lock" class="icon-sm" /> On the payment provider's secure page</span>
                    </div>
                    <form method="post" asp-action="Review" class="panel-body stack">
                        <div>
                            <div class="form-label">Plan</div>
                            <div class="choice-grid" role="radiogroup" aria-label="Plan">
                                @foreach (var plan in Model.Mine.Plans)
                                {
                                    var current = plan.Id == s.PlanId;
                                    <label class="choice-card @(current ? "is-current" : "")">
                                        <input type="radio" name="PlanId" value="@plan.Id" checked="@current" />
                                        <span class="choice-check"><icon name="check" /></span>
                                        <span class="choice-title">@plan.Name @if (current) {<span class="badge text-bg-primary ms-1">Your plan</span>}</span>
                                        <span class="choice-price">@Display.Money(plan.MonthlyPrice, plan.Currency) <small>/month</small></span>
                                        <span class="choice-desc">or @Display.Money(plan.AnnualPrice, plan.Currency) /year</span>
                                        @if (plan.Description is not null) {<span class="choice-desc">@plan.Description</span>}
                                        <partial name="_PlanFeatures" model="plan" />
                                    </label>
                                }
                            </div>
                        </div>
                        <div>
                            <div class="form-label">Pay for</div>
                            <div class="segmented" role="radiogroup" aria-label="Billing cycle">
                                <input type="radio" name="BillingCycle" id="pay-monthly" value="Monthly" checked="@(s.BillingCycle == BillingCycle.Monthly)" /><label for="pay-monthly">A month</label>
                                <input type="radio" name="BillingCycle" id="pay-annual" value="Annual" checked="@(s.BillingCycle == BillingCycle.Annual)" /><label for="pay-annual">A year</label>
                            </div>
                        </div>
                        <div>
                            <div class="form-label">Pay with</div>
                            <div class="choice-grid" role="radiogroup" aria-label="Payment provider">
                                @for (var i = 0; i < Model.Gateways.Count; i++)
                                {
                                    var g = Model.Gateways[i];
                                    <label class="choice-card">
                                        <input type="radio" name="Gateway" value="@g.Code" checked="@(i == 0)" data-recurring="@(g.SupportsRecurring ? "true" : "false")" />
                                        <span class="choice-check"><icon name="check" /></span>
                                        <span class="choice-title"><icon name="credit-card" class="icon-sm" /> @g.Name</span>
                                        <span class="chip-group">@foreach (var m in g.Methods) {<span class="chip">@m</span>}</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <label class="form-check form-switch mb-0" data-renew-option hidden="@(!Model.Gateways.Any(g => g.SupportsRecurring))">
                            <input class="form-check-input" type="checkbox" role="switch" name="RenewAutomatically" value="true" checked />
                            <span class="form-check-label"><strong>Renew automatically.</strong> The payment provider charges this amount every month or year, until you turn it off here.@foreach (var capped in Model.Gateways.Where(g => g.SupportsRecurring && g.MaximumRecurringCharge is not null)) {<span class="d-block text-muted small">@capped.Name renews automatically up to @Display.Money(capped.MaximumRecurringCharge!.Value, s.Currency); pay larger amounts once.</span>}</span>
                        </label>
                        @if (s.Status == SubscriptionStatus.Active)
                        {
                            <p class="text-muted small mb-0">The same plan and period adds time after your current period. A dearer plan starts today and you pay only the difference for the rest of the period. A cheaper plan, or paying yearly instead of monthly (or the other way), starts when your current period ends, with nothing to pay now. You'll see what changes before you confirm.</p>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">Paying starts a fresh period on the plan you choose, from today. Your organisation is emailed a receipt.</p>
                        }
                        <div><button type="submit" class="btn btn-primary">Continue <icon name="arrow-right" class="icon-sm" /></button></div>
                    </form>
                </section>
            }
            else if (Model.Mine.Plans.Count > 0)
            {
                <section aria-labelledby="compare-title">
                    <h2 class="h5 mb-3" id="compare-title">Plans</h2>
                    <div class="choice-grid">
                        @foreach (var plan in Model.Mine.Plans)
                        {
                            var current = plan.Id == s.PlanId;
                            <div class="choice-card @(current ? "is-current" : "")">
                                <span class="choice-title">@plan.Name @if (current) {<span class="badge text-bg-primary ms-1">Your plan</span>}</span>
                                <span class="choice-price">@Display.Money(plan.MonthlyPrice, plan.Currency) <small>/month</small></span>
                                @if (plan.Description is not null) {<span class="choice-desc">@plan.Description</span>}
                                <partial name="_PlanFeatures" model="plan" />
                            </div>
                        }
                    </div>
                    <p class="text-muted small mt-3 mb-0">@(Model.CanPay ? "Online payment isn't set up yet. To pay or change plan, contact us." : "To change plan, ask an administrator.")</p>
                </section>
            }

            @if (Model.Payments.Count > 0)
            {
                <section class="panel" aria-labelledby="payments-title">
                    <div class="panel-header"><h2 class="panel-title" id="payments-title">Payments</h2></div>
                    <ul class="item-list">
                        @foreach (var p in Model.Payments)
                        {
                            <li>
                                <span class="file-tile" aria-hidden="true"><icon name="receipt" /></span>
                                <a class="item-main text-decoration-none" asp-action="Payment" asp-route-reference="@p.Reference">
                                    <div class="item-title">@p.Description</div>
                                    <div class="item-sub"><span class="mono">@p.Reference</span> · @p.GatewayName · @(p.IsRenewal ? "automatic renewal" : "by " + p.RequestedByName)@(p.SetsUpRenewal ? " · set up automatic renewal" : "")@(p.IsUpgrade ? " · upgrade" : "")</div>
                                </a>
                                <div class="item-aside text-end">
                                    <div class="fw-semibold">@Display.Money(p.Amount, p.Currency)</div>
                                    <span class="badge text-bg-@Display.Tone(p.Status)">@Display.Status(p.Status)</span>
                                    <div class="small text-muted mt-1"><local-time value="p.CreatedAt" format="d MMM yyyy" /></div>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
        <section class="panel" aria-labelledby="usage-title">
            <div class="panel-header"><h2 class="panel-title" id="usage-title">Usage</h2></div>
            <div class="panel-body"><partial name="_UsageMeters" model="Model.Mine.Usage" /></div>
        </section>
    </div>
}
