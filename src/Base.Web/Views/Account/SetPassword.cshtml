@model SetPasswordViewModel
@{
    Layout = "_AuthLayout";
    var isInvite = Model.Kind == Base.Application.Users.PasswordTokenKind.Invite;
    ViewData["Title"] = isInvite ? "Activate your account" : "Choose a new password";
}
    <h1 class="h4 mb-1">@ViewData["Title"]</h1>
    <p class="auth-subtitle">Choose a strong password you don't use anywhere else.</p>
    <form asp-action="SetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Kind" />
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label"></label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
            <div class="form-text">At least 12 characters. A passphrase of a few words works well.</div>
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Save password</button>
    </form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
