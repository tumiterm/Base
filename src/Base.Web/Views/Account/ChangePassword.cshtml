@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Change password</h1>
        <p class="page-subtitle">Your other signed-in devices are signed out within a minute.</p>
    </div>
</div>
<div class="detail-grid">
    <form asp-action="ChangePassword" method="post" class="panel" novalidate>
        <div class="panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <section class="form-section">
                <div>
                    <h2 class="form-section-title">Current password</h2>
                    <p class="form-section-desc">To confirm it's you.</p>
                </div>
                <div>
                    <label asp-for="CurrentPassword" class="form-label">Current password</label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
            </section>
            <section class="form-section">
                <div>
                    <h2 class="form-section-title">New password</h2>
                    <p class="form-section-desc">At least 12 characters. A passphrase of a few words works well.</p>
                </div>
                <div class="stack">
                    <div>
                        <label asp-for="NewPassword" class="form-label">New password</label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="ConfirmPassword" class="form-label">Type it again</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </section>
        </div>
        <div class="panel-footer d-flex justify-content-end gap-2">
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary"><icon name="key-round" class="icon-sm" /> Change password</button>
        </div>
    </form>
    <aside class="stack">
        <section class="panel" aria-labelledby="tips-title">
            <div class="panel-header"><h2 class="panel-title" id="tips-title">A good password</h2></div>
            <div class="panel-body">
                <ul class="small text-muted mb-0 ps-3">
                    <li>Is long rather than complicated: “orange river kettle summer” beats “P@ss1!”.</li>
                    <li>Isn't used on any other site.</li>
                    <li>Lives in a password manager, not on a note.</li>
                </ul>
            </div>
        </section>
    </aside>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
