@model IReadOnlyList<Base.Application.Users.RoleSummary>
@{
    ViewData["Title"] = "Roles";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Roles</h1>
        <p class="page-subtitle">Permissions grouped for assigning to people.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New role</a>
</div>
<table class="table table-hover align-middle">
    <thead>
        <tr><th>Role</th><th>Permissions</th><th>Users</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>
                    <a asp-action="Edit" asp-route-id="@role.Id">@role.Name</a>
                    @if (role.IsSystem) { <span class="badge text-bg-secondary ms-1">System</span> }
                    @if (!string.IsNullOrEmpty(role.Description)) { <div class="small text-muted">@role.Description</div> }
                </td>
                <td>@role.Permissions.Count</td>
                <td>@role.UserCount</td>
                <td class="text-end">
                    @if (!role.IsSystem && role.UserCount == 0)
                    {
                        <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
