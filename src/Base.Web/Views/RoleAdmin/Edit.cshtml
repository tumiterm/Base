@model EditRoleViewModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "New role" : Model.Name;
    var action = isNew ? "Create" : "Edit";
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<form asp-action="@action" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" readonly="@Model.IsSystem" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    @if (Model.IsAdministrator)
    {
        <div class="alert alert-info">Administrators always hold every permission.</div>
    }
    <span class="text-danger small">@Html.ValidationMessage("Permissions")</span>
    <div class="row g-3">
        @foreach (var module in EditRoleViewModel.Modules)
        {
            <fieldset class="col-md-6 col-lg-4">
                <legend class="fs-6 fw-semibold">@module.Key</legend>
                @foreach (var permission in module)
                {
                    var id = "perm-" + permission.Key.Replace('.', '-');
                    var isChecked = Model.IsAdministrator || Model.Permissions.Contains(permission.Key, StringComparer.Ordinal);
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Permissions" value="@permission.Key" id="@id" checked="@isChecked" disabled="@Model.IsAdministrator" />
                        <label class="form-check-label" for="@id">
                            @permission.Label
                            <span class="d-block small text-muted">@permission.Description</span>
                        </label>
                    </div>
                    @if (Model.IsAdministrator)
                    {
                        <input type="hidden" name="Permissions" value="@permission.Key" />
                    }
                }
            </fieldset>
        }
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>
