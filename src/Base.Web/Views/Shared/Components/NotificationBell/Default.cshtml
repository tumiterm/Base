@model int
<a class="icon-btn" asp-controller="Notifications" asp-action="Index" title="Notifications" aria-label="Notifications, @Model unread">
    <icon name="bell" />
    @if (Model > 0)
    {
        <span class="dot" aria-hidden="true">@(Model > 99 ? "99+" : Model.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
    }
</a>
