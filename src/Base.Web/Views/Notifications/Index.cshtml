@model Base.Application.Common.Persistence.PagedResult<Base.Application.Notifications.InboxItem>
@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Items.Count(i => i.ReadAt is null);
}
<div class="page-header">
    <div>
        <h1 class="page-title">Notifications</h1>
        <p class="page-subtitle">@(unread == 0 ? "You're all caught up." : $"{unread} unread on this page.")</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-ghost" asp-action="Preferences"><icon name="sliders-horizontal" class="icon-sm" /> Preferences</a>
        @if (unread > 0)
        {
            <form asp-action="MarkAllRead" method="post"><button class="btn btn-secondary" type="submit"><icon name="check" class="icon-sm" /> Mark all as read</button></form>
        }
    </div>
</div>
@if (Model.Total == 0)
{
    <div class="empty-state">
        <icon name="bell" />
        <div class="empty-state-title">Nothing here yet</div>
        <p class="mb-0">When something needs your attention (an export is ready, a key is about to expire) it shows up here.</p>
    </div>
}
else
{
    <section class="panel">
        <ul class="item-list">
            @foreach (var item in Model.Items)
            {
                var isUnread = item.ReadAt is null;
                <li class="@(isUnread ? "is-unread" : "")">
                    <span class="state-dot @(isUnread ? "is-info" : "")" aria-hidden="true"></span>
                    <div class="item-main">
                        <div class="item-title">@item.Title @if (isUnread) {<span class="visually-hidden">(unread)</span>}</div>
                        @if (!string.IsNullOrEmpty(item.Body)) {<div class="item-sub">@item.Body</div>}
                    </div>
                    <div class="item-aside">
                        <local-time value="item.CreatedAt" format="d MMM, HH:mm" />
                        @if (isUnread)
                        {
                            <form asp-action="MarkRead" asp-route-id="@item.Id" method="post" class="mt-1"><button class="btn-inline" type="submit">Mark read</button></form>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted small">Page @Model.Page of @Model.TotalPages</span>
            <nav class="btn-group btn-group-sm" aria-label="Pages">
                <a class="btn btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")" asp-route-page="@(Model.Page - 1)">Previous</a>
                <a class="btn btn-outline-secondary @(Model.HasNext ? "" : "disabled")" asp-route-page="@(Model.Page + 1)">Next</a>
            </nav>
        </div>
    }
}
