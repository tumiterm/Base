@model Base.Application.Common.Persistence.PagedResult<Base.Application.Notifications.InboxItem>
@{
    ViewData["Title"] = "Notifications";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Notifications</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-link" asp-action="Preferences">Preferences</a>
        @if (Model.Items.Any(i => i.ReadAt is null))
        {
            <form asp-action="MarkAllRead" method="post"><button class="btn btn-outline-secondary" type="submit">Mark all as read</button></form>
        }
    </div>
</div>
@if (Model.Total == 0)
{
    <p class="text-muted">Nothing here yet.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var item in Model.Items)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start @(item.ReadAt is null ? "list-group-item-light fw-semibold" : "")">
                <div>
                    <div>@item.Title</div>
                    @if (!string.IsNullOrEmpty(item.Body)) { <div class="small fw-normal">@item.Body</div> }
                    <div class="small text-muted fw-normal"><local-time value="@item.CreatedAt" /></div>
                </div>
                @if (item.ReadAt is null)
                {
                    <form asp-action="MarkRead" asp-route-id="@item.Id" method="post"><button class="btn btn-sm btn-link" type="submit">Mark read</button></form>
                }
            </li>
        }
    </ul>
    <nav class="d-flex justify-content-between">
        <span class="text-muted small">Page @Model.Page of @Model.TotalPages</span>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(Model.HasPrevious ? "" : "disabled")" asp-route-page="@(Model.Page - 1)">Previous</a>
            <a class="btn btn-outline-secondary btn-sm @(Model.HasNext ? "" : "disabled")" asp-route-page="@(Model.Page + 1)">Next</a>
        </div>
    </nav>
}
