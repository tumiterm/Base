@model Base.Application.Common.Persistence.PagedResult<Base.Application.DataExchange.ExportJobView>
@using Base.Domain.DataExchange
@{
    ViewData["Title"] = "My exports";
}
<div class="page-header">
    <div>
        <h1 class="page-title">Import and export</h1>
        <p class="page-subtitle">Export any list with the Export buttons on it. Big exports are prepared in the background, and their files wait here for a few days.</p>
    </div>
</div>
<partial name="_DataExchangeTabs" model='"exports"' />
@if (Model.Total == 0)
{
    <div class="empty-state">
        <icon name="download" />
        <div class="empty-state-title">No exports yet</div>
        <p class="mb-0">Use Export Excel or CSV on People, Users, Documents or the audit trail.</p>
    </div>
}
else
{
    <section class="panel">
        <ul class="item-list">
            @foreach (var job in Model.Items)
            {
                var (tone, label) = job.Status switch { ExportStatus.Completed => ("success", "Ready"), ExportStatus.Failed => ("danger", "Failed"), _ => ("info", "Preparing") };
                var sheet = job.Format.ToString().ToUpperInvariant();
                <li>
                    <span class="file-tile is-sheet" aria-hidden="true"><icon name="file-spreadsheet" /></span>
                    <div class="item-main">
                        <div class="item-title">@job.ExporterName <span class="chip ms-1">@sheet</span></div>
                        <div class="item-sub">@job.RowCount.ToString("N0") row@(job.RowCount == 1 ? "" : "s") · requested <local-time value="job.RequestedAt" format="d MMM yyyy, HH:mm" /></div>
                        @if (job.Error is not null) {<div class="item-sub text-danger">@job.Error</div>}
                    </div>
                    <span class="badge text-bg-@tone">@label</span>
                    @if (job.CanDownload)
                    {
                        <a class="btn btn-secondary btn-sm" asp-action="Download" asp-route-id="@job.Id"><icon name="download" class="icon-sm" /> Download</a>
                    }
                </li>
            }
        </ul>
    </section>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted small">Page @Model.Page of @Model.TotalPages</span>
            <nav class="btn-group btn-group-sm" aria-label="Pages">
                <a class="btn btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")" asp-route-page="@(Model.Page - 1)">Previous</a>
                <a class="btn btn-outline-secondary @(Model.HasNext ? "" : "disabled")" asp-route-page="@(Model.Page + 1)">Next</a>
            </nav>
        </div>
    }
}
