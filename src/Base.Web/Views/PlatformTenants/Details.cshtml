@model TenantDetailsViewModel
@inject ICurrentUser CurrentUser
@inject TimeProvider Time
@inject Base.Application.Releases.ITenantReleases Releases
@inject IWebHostEnvironment Env
@inject Base.Application.Settings.IApplicationSettingService Settings
@using Base.Application.Tenancy
@{
    var t = Model.Details.Tenant;
    var s = Model.Details.Subscription;
    ViewData["Title"] = t.Name;
    var canManage = CurrentUser.HasPermission(PermissionCodes.Platform.TenantsManage);
    var now = Time.GetUtcNow();
    var admins = Model.Details.Users.Where(u => u.Roles.Contains(RoleNames.Administrator)).ToList();
    var reachable = Model.Details.Domains.Any(d => d.IsVerified);
    var accepted = admins.Exists(u => u.HasPassword);
    var signedIn = admins.Exists(u => u.LastSignInAt is not null);
    var emailOk = Model.EmailRoute.Delivers;
    var steps = new[] { true, reachable, admins.Count > 0, emailOk, accepted && signedIn };
    var done = steps.Count(x => x);
    var platformAddress = await Settings.GetAsync(Base.Application.Settings.SettingCodes.General.PublicBaseUrl);
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a asp-action="Index">Tenants</a><icon name="chevron-right" class="icon-sm" /><span aria-current="page">@t.Name</span></nav>
<div class="page-header">
    <div class="entity">
        <span class="avatar avatar-lg avatar-square" aria-hidden="true">@Display.Initials(t.Name)</span>
        <div class="entity-text">
            <h1 class="page-title">@t.Name</h1>
            <p class="page-subtitle">
                <span class="font-monospace">@t.Code</span>
                @if (t.PrimaryHost is not null) {<text> · </text><a href="@TenantAddresses.Url(t.PrimaryHost, platformAddress)" rel="noopener" target="_blank">@t.PrimaryHost <icon name="external-link" class="icon-sm" /></a>}
                · @t.UserCount @(t.UserCount == 1 ? "user" : "users")
            </p>
        </div>
    </div>
    <div class="page-actions">
        @if (t.IsPlatform) {<span class="badge text-bg-light">Platform tenant</span>}
        else if (!t.IsActive) {<span class="badge text-bg-secondary">Deactivated</span>}
        @if (canManage && !t.IsPlatform)
        {
            <div class="dropdown">
                <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><icon name="ellipsis" class="icon-sm" /> More</button>
                <div class="dropdown-menu dropdown-menu-end">
                    <form method="post" asp-action="SetActive" asp-route-id="@t.Id">
                        <input type="hidden" name="active" value="@(t.IsActive ? "false" : "true")" />
                        @if (t.IsActive)
                        {
                            <button class="dropdown-item text-danger" type="submit"><icon name="ban" class="icon-sm" /> Deactivate tenant</button>
                        }
                        else
                        {
                            <button class="dropdown-item" type="submit"><icon name="circle-play" class="icon-sm" /> Activate tenant</button>
                        }
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div class="detail-grid">
    <div class="stack">
        @if (!t.IsPlatform)
        {
            <section class="panel" aria-labelledby="start-title">
                <div class="panel-header">
                    <h2 class="panel-title" id="start-title">Getting started</h2>
                    <span class="text-muted small">@done of @steps.Length done</span>
                </div>
                <ol class="checklist">
                    <li class="is-done">
                        <icon name="circle-check" />
                        <div><div class="checklist-title">Organisation created</div><div class="checklist-desc"><local-time value="t.DateCreated" format="d MMM yyyy" />. Its own data, users and settings, separate from every other tenant.</div></div>
                    </li>
                    <li class="@(reachable ? "is-done" : "is-alert")">
                        <icon name="@(reachable ? "circle-check" : "triangle-alert")" />
                        <div>
                            <div class="checklist-title">@(reachable ? "Reachable at " + TenantAddresses.Url(t.PrimaryHost!, platformAddress) : "No address yet")</div>
                            <div class="checklist-desc">@(reachable ? "Its people sign in there. Links in its emails point there too." : "Nobody can reach this tenant until it has a verified domain. Add one under Domains, point its DNS at the platform, then mark it verified.")</div>
                        </div>
                    </li>
                    <li class="@(admins.Count > 0 ? "is-done" : "is-alert")">
                        <icon name="@(admins.Count > 0 ? "circle-check" : "triangle-alert")" />
                        <div>
                            <div class="checklist-title">@(admins.Count > 0 ? (admins.Count == 1 ? admins[0].DisplayName + " invited as administrator" : admins.Count + " administrators invited") : "No administrator yet")</div>
                            <div class="checklist-desc">The welcome email has a link to set a password (valid 3 days), the sign-in address, and the first steps: invite their team, add their logo, check their settings.</div>
                            @if (canManage && admins.Count == 0)
                            {
                                <button class="btn btn-secondary btn-sm mt-2" type="button" data-bs-toggle="modal" data-bs-target="#admin-dialog"><icon name="user-plus" class="icon-sm" /> Invite an administrator</button>
                            }
                        </div>
                    </li>
                    <li class="@(emailOk ? "is-done" : "is-alert")">
                        <icon name="@(emailOk ? "circle-check" : "triangle-alert")" />
                        <div>
                            <div class="checklist-title">@(emailOk ? "Email is being delivered" : "Email isn't being delivered")</div>
                            <div class="checklist-desc">@Model.EmailRoute.Description @(emailOk ? "" : "Until it is, invitations only reach the log and nobody receives them.")</div>
                            @if (!emailOk)
                            {
                                <a class="btn btn-secondary btn-sm mt-2" asp-controller="SettingsAdmin" asp-action="Index" asp-route-category="Email" asp-permission="@PermissionCodes.Settings.Edit"><icon name="mail" class="icon-sm" /> Set up email</a>
                            }
                        </div>
                    </li>
                    <li class="@(accepted && signedIn ? "is-done" : "")">
                        <icon name="@(accepted && signedIn ? "circle-check" : "circle-dashed")" />
                        <div>
                            <div class="checklist-title">@(signedIn ? "Their administrator has signed in" : accepted ? "Password set, not signed in yet" : "Waiting for them to accept")</div>
                            <div class="checklist-desc">@(signedIn ? "From here they run their own organisation: users, roles, branding and settings." : "Nothing more to do on your side. If the email went missing, resend it or copy their link from People and send it another way.")</div>
                        </div>
                    </li>
                </ol>
            </section>
        }
        <section class="panel" aria-labelledby="sub-title">
            <div class="panel-header">
                <h2 class="panel-title" id="sub-title">Subscription</h2>
                <partial name="_SubscriptionStatus" model="s?.Status" />
            </div>
            @if (s is null)
            {
                <div class="panel-body">
                    @if (t.IsPlatform)
                    {
                        <p class="text-muted mb-0">The platform tenant has no subscription; nothing in it is limited.</p>
                    }
                    else
                    {
                        <p class="text-muted">No subscription: every feature is on and nothing is limited.</p>
                        @if (canManage && Model.Plans.Count > 0)
                        {
                            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#subscribe-dialog"><icon name="credit-card" class="icon-sm" /> Subscribe to a plan</button>
                        }
                    }
                </div>
            }
            else
            {
                <div class="panel-body">
                    <div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-3">
                        <div>
                            <div class="h4 mb-0">@s.PlanName</div>
                            <div class="text-muted">@Display.Money(s.Price, s.Currency)@Display.PerCycle(s.BillingCycle) · billed @s.BillingCycle.ToString().ToLowerInvariant()</div>
                        </div>
                        @if (s.StatusReason is not null) {<span class="chip"><icon name="info" /> @s.StatusReason</span>}
                    </div>
                    <ol class="timeline">
                        <li class="is-done"><div class="timeline-title">Started</div><div class="timeline-time"><local-time value="s.StartedAt" /></div></li>
                        @if (s.TrialEndsAt is { } trialEnd)
                        {
                            <li class="@(trialEnd <= now ? "is-done" : s.Status == SubscriptionStatus.Trialing ? "is-current" : "")"><div class="timeline-title">Trial @(trialEnd <= now ? "ended" : "ends")</div><div class="timeline-time"><local-time value="trialEnd" /></div></li>
                        }
                        @if (s.Status is SubscriptionStatus.Active or SubscriptionStatus.PastDue || s.TrialEndsAt is null || s.TrialEndsAt < s.CurrentPeriodEnd)
                        {
                            var label = s.IsEnded ? "Ended" : s.CancelAtPeriodEnd ? "Ends" : s.CurrentPeriodEnd <= now ? "Renewal was due" : "Renews";
                            <li class="@(s.Status is SubscriptionStatus.PastDue ? "is-alert" : s.CurrentPeriodEnd <= now ? "is-done" : "is-current")"><div class="timeline-title">@label</div><div class="timeline-time"><local-time value="s.CurrentPeriodEnd" /></div></li>
                        }
                        @if (s.Status is SubscriptionStatus.Suspended or SubscriptionStatus.Cancelled or SubscriptionStatus.Expired)
                        {
                            <li class="is-alert"><div class="timeline-title">@Display.Status(s.Status)</div><div class="timeline-time"><local-time value="s.StatusChangedAt" /></div></li>
                        }
                    </ol>
                    @if (s.Scheduled is { } next)
                    {
                        <div class="status-callout is-warning mt-3">
                            <icon name="calendar" />
                            <div class="flex-grow-1">
                                <div class="status-callout-title">Moves to @next.PlanName on <local-time value="next.At" format="d MMMM yyyy" /></div>
                                <div class="small">@Display.Money(next.Price, next.Currency)@Display.PerCycle(next.BillingCycle) from then. Until then its limits apply too, so the tenant can't outgrow it.</div>
                            </div>
                            @if (canManage)
                            {
                                <form method="post" asp-action="WithdrawPlanChange" asp-route-id="@t.Id"><button type="submit" class="btn btn-secondary btn-sm">Withdraw</button></form>
                            }
                        </div>
                    }
                    @if (s.ExternalReference is not null)
                    {
                        <dl class="kv mt-3"><dt>Billing reference</dt><dd class="font-monospace">@s.ExternalReference</dd></dl>
                    }
                </div>
                @if (canManage)
                {
                    <div class="panel-footer d-flex flex-wrap gap-2">
                        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#payment-dialog"><icon name="receipt" class="icon-sm" /> Record payment</button>
                        <button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#plan-dialog"><icon name="layers" class="icon-sm" /> Change plan</button>
                        @if (s.Status == SubscriptionStatus.Trialing)
                        {
                            <button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#extend-dialog"><icon name="calendar" class="icon-sm" /> Extend trial</button>
                        }
                        <span class="flex-grow-1"></span>
                        <div class="dropdown">
                            <button class="btn btn-ghost btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">More actions</button>
                            <div class="dropdown-menu dropdown-menu-end">
                                @if (s.Status == SubscriptionStatus.Suspended)
                                {
                                    <form method="post" asp-action="Reinstate" asp-route-id="@t.Id"><button class="dropdown-item" type="submit"><icon name="rotate-ccw" class="icon-sm" /> Reinstate</button></form>
                                }
                                else if (!s.IsEnded)
                                {
                                    <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#suspend-dialog"><icon name="circle-pause" class="icon-sm" /> Suspend…</button>
                                }
                                @if (s.CancelAtPeriodEnd && !s.IsEnded)
                                {
                                    <form method="post" asp-action="Resume" asp-route-id="@t.Id"><button class="dropdown-item" type="submit"><icon name="circle-play" class="icon-sm" /> Keep renewing</button></form>
                                }
                                else if (s.HasAccess)
                                {
                                    <form method="post" asp-action="Cancel" asp-route-id="@t.Id"><input type="hidden" name="atPeriodEnd" value="true" /><button class="dropdown-item" type="submit"><icon name="calendar" class="icon-sm" /> Cancel at period end</button></form>
                                }
                                @if (!s.IsEnded)
                                {
                                    <div class="dropdown-divider"></div>
                                    <form method="post" asp-action="Cancel" asp-route-id="@t.Id"><input type="hidden" name="atPeriodEnd" value="false" /><button class="dropdown-item text-danger" type="submit"><icon name="circle-x" class="icon-sm" /> Cancel now</button></form>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </section>

        <section class="panel" aria-labelledby="usage-title">
            <div class="panel-header"><h2 class="panel-title" id="usage-title">Usage</h2><span class="text-muted small">Against the plan's limits</span></div>
            <div class="panel-body"><partial name="_UsageMeters" model="Model.Details.Usage" /></div>
        </section>

        @if (Model.Billing is { Count: > 0 } billing)
        {
            <section class="panel" aria-labelledby="billing-title">
                <div class="panel-header"><h2 class="panel-title" id="billing-title">Billing history</h2><a class="small" asp-action="Billing" asp-route-id="@t.Id">See all</a></div>
                <div class="panel-body"><partial name="_BillingHistory" model="billing" /></div>
            </section>
        }
    </div>

    <div class="stack">
        <section class="panel" aria-labelledby="org-title">
            <div class="panel-header"><h2 class="panel-title" id="org-title">Organisation</h2></div>
            <div class="panel-body">
                @if (canManage)
                {
                    <form method="post" asp-action="Update" asp-route-id="@t.Id" class="stack">
                        <div>
                            <label class="form-label" for="org-name">Name</label>
                            <input class="form-control" id="org-name" name="name" value="@t.Name" required />
                        </div>
                        <div>
                            <label class="form-label" for="org-contact">Billing contact</label>
                            <input class="form-control" id="org-contact" name="contactEmail" type="email" value="@t.ContactEmail" placeholder="billing@example.com" />
                            <div class="form-text">Trial and payment notices go here.</div>
                        </div>
                        <div><button class="btn btn-secondary btn-sm" type="submit">Save</button></div>
                    </form>
                }
                else
                {
                    <dl class="kv"><dt>Billing contact</dt><dd>@(t.ContactEmail ?? "—")</dd><dt>Created</dt><dd><local-time value="t.DateCreated" format="d MMM yyyy" /></dd></dl>
                }
            </div>
        </section>

        @{
            var release = await Releases.GetForAsync(t.Id);
        }
        @if (release is not null)
        {
            <section class="panel" aria-labelledby="release-panel-title">
                <div class="panel-header">
                    <h2 class="panel-title" id="release-panel-title">Release</h2>
                    @if (release.IsUpToDate) {<span class="badge text-bg-success">Up to date</span>} else {<span class="badge text-bg-warning">@release.Behind behind</span>}
                </div>
                <div class="panel-body">
                    <dl class="kv">
                        <dt>On</dt><dd class="tabular">@Base.Application.Releases.ReleaseVersions.Label(release.EffectiveVersion)@(release.IsUpToDate ? "" : $" (running {release.CurrentVersion})")</dd>
                        @if (release.AdoptedAt is { } adoptedAt) {<dt>Last taken</dt><dd><local-time value="adoptedAt" format="d MMM yyyy" /></dd>}
                        @if (!release.IsUpToDate) {<dt>Waiting</dt><dd>@release.Pending.Sum(p => p.Features.Count) feature(s) in @string.Join(", ", release.Pending.Select(p => p.Version))@(release.OnEarly > 0 ? $"; {release.OnEarly} switched on early" : "")</dd>}
                    </dl>
                </div>
                <div class="panel-footer small text-muted">They take releases from What's new; you see the spread under <a asp-controller="PlatformReleases" asp-action="Index">Releases</a>.</div>
            </section>
        }

        <section class="panel" aria-labelledby="people-title">
            <div class="panel-header">
                <h2 class="panel-title" id="people-title">People</h2>
                <span class="text-muted small">@t.UserCount</span>
            </div>
            @if (Model.Details.Users.Count == 0)
            {
                <div class="panel-body text-muted small">No users yet.</div>
            }
            else
            {
                <ul class="person-list">
                    @foreach (var u in Model.Details.Users)
                    {
                        var state = u.IsLockedOut ? ("Locked", "danger") : !u.HasPassword ? ("Invited", "warning") : u.LastSignInAt is null ? ("Not signed in yet", "secondary") : ("Active", "success");
                        <li>
                            <span class="avatar" aria-hidden="true">@Display.Initials(u.DisplayName)</span>
                            <div class="person-main">
                                <div class="person-name">@u.DisplayName</div>
                                <div class="person-sub">@u.Email</div>
                                <div class="person-sub">
                                    @string.Join(", ", u.Roles)
                                    @if (u.LastSignInAt is { } last) {<text> · last signed in <local-time value="last" format="d MMM yyyy" /></text>}
                                    else if (!u.HasPassword) {<text> · invited <local-time value="u.DateCreated" format="d MMM yyyy" /></text>}
                                </div>
                            </div>
                            <span class="badge text-bg-@state.Item2">@state.Item1</span>
                            @if (canManage && !u.HasPassword && !u.IsLockedOut)
                            {
                                <form method="post" asp-action="InviteLink" asp-route-id="@t.Id" asp-route-userId="@u.Id" data-invite-link>
                                    <button class="icon-btn" type="submit" title="Copy invitation link" aria-label="Copy the invitation link for @u.DisplayName"><icon name="link" /></button>
                                </form>
                                <form method="post" asp-action="ResendWelcome" asp-route-id="@t.Id" asp-route-userId="@u.Id">
                                    <button class="icon-btn" type="submit" title="Send the welcome email again" aria-label="Send the welcome email to @u.DisplayName again"><icon name="send" /></button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            @if (canManage && !t.IsPlatform)
            {
                <div class="panel-footer d-flex flex-wrap align-items-center gap-2">
                    <button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#admin-dialog"><icon name="user-plus" class="icon-sm" /> Invite an administrator</button>
                    <span class="text-muted small">They invite the rest of their team themselves.</span>
                </div>
            }
        </section>

        <section class="panel" aria-labelledby="domains-title">
            <div class="panel-header"><h2 class="panel-title" id="domains-title">Domains</h2><span class="text-muted small">@Model.Details.Domains.Count</span></div>
            @if (Model.Details.Domains.Count == 0)
            {
                <div class="panel-body text-muted small">No domains. The tenant can only be reached through a verified domain.</div>
            }
            else
            {
                <ul class="list-unstyled m-0">
                    @foreach (var d in Model.Details.Domains)
                    {
                        <li class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                            <icon name="globe" class="icon-sm text-muted" />
                            <span class="flex-grow-1 text-truncate">@d.Host</span>
                            @if (d.IsVerified) {<span class="badge text-bg-success">Verified</span>} else {<span class="badge text-bg-warning">Unverified</span>}
                            @if (canManage)
                            {
                                <div class="dropdown">
                                    <button class="icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @d.Host"><icon name="ellipsis" /></button>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        @if (!d.IsVerified)
                                        {
                                            <form method="post" asp-action="VerifyDomain" asp-route-id="@t.Id" asp-route-domainId="@d.Id"><button class="dropdown-item" type="submit"><icon name="check" class="icon-sm" /> Mark verified</button></form>
                                        }
                                        <form method="post" asp-action="RemoveDomain" asp-route-id="@t.Id" asp-route-domainId="@d.Id"><button class="dropdown-item text-danger" type="submit"><icon name="trash-2" class="icon-sm" /> Remove</button></form>
                                    </div>
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            @if (canManage)
            {
                <form method="post" asp-action="AddDomain" asp-route-id="@t.Id" class="panel-footer d-flex gap-2">
                    <input class="form-control form-control-sm" name="host" placeholder="@(Env.IsDevelopment() ? "mtn.dev.localhost" : "mtn.base.co.za")" aria-label="New domain" spellcheck="false" autocapitalize="off" required />
                    <button class="btn btn-secondary btn-sm" type="submit"><icon name="plus" class="icon-sm" /> Add</button>
                </form>
                <div class="px-3 pb-3"><partial name="_DomainHelp" /></div>
            }
        </section>
    </div>
</div>

@if (canManage && !t.IsPlatform)
{
    <div class="modal fade" id="admin-dialog" tabindex="-1" aria-labelledby="admin-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-action="InviteAdministrator" asp-route-id="@t.Id">
                <div class="modal-header"><h2 class="modal-title" id="admin-title">Invite an administrator to @t.Name</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body stack">
                    <p class="text-muted mb-0">They get the welcome email: a link to set their password, where to sign in, and what to do first.</p>
                    <div><label class="form-label" for="admin-name">Full name</label><input class="form-control" id="admin-name" name="name" maxlength="100" required autocomplete="off" /></div>
                    <div><label class="form-label" for="admin-email">Email</label><input class="form-control" id="admin-email" name="email" type="email" maxlength="256" required autocomplete="off" /></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit"><icon name="send" class="icon-sm" /> Send invitation</button></div>
            </form>
        </div>
    </div>
}

@if (canManage)
{
    var plans = Model.Plans;
    <div class="modal fade" id="subscribe-dialog" tabindex="-1" aria-labelledby="subscribe-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post" asp-action="Subscribe" asp-route-id="@t.Id">
                <div class="modal-header"><h2 class="modal-title" id="subscribe-title">Subscribe to a plan</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body stack">
                    <partial name="_PlanPicker" model="(plans, (Guid?)null, BillingCycle.Monthly)" />
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="sub-trial" name="withTrial" value="true" checked />
                        <input type="hidden" name="withTrial" value="false" />
                        <label class="form-check-label" for="sub-trial">Start with the plan's free trial</label>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Subscribe</button></div>
            </form>
        </div>
    </div>

    @if (s is not null)
    {
        <div class="modal fade" id="payment-dialog" tabindex="-1" aria-labelledby="payment-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" method="post" asp-action="RecordPayment" asp-route-id="@t.Id">
                    <div class="modal-header"><h2 class="modal-title" id="payment-title">Record a payment</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body stack">
                        <p class="text-muted mb-0">Makes the subscription active for one more @(s.BillingCycle == BillingCycle.Annual ? "year" : "month") (@Display.Money(s.Price, s.Currency)), from today or from the end of the period already paid.</p>
                        <div>
                            <label class="form-label" for="pay-ref">Reference <span class="text-muted fw-normal">(optional)</span></label>
                            <input class="form-control font-monospace" id="pay-ref" name="reference" maxlength="200" value="@s.ExternalReference" placeholder="Invoice or transaction number" />
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Record payment</button></div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="plan-dialog" tabindex="-1" aria-labelledby="plan-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <form class="modal-content" method="get" asp-action="ChangePlan" asp-route-id="@t.Id">
                    <div class="modal-header"><h2 class="modal-title" id="plan-title">Change plan</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body"><partial name="_PlanPicker" model="(plans, (Guid?)s.PlanId, s.BillingCycle)" /></div>
                    <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Review the change <icon name="arrow-right" class="icon-sm" /></button></div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="extend-dialog" tabindex="-1" aria-labelledby="extend-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" method="post" asp-action="ExtendTrial" asp-route-id="@t.Id">
                    <div class="modal-header"><h2 class="modal-title" id="extend-title">Extend the trial</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body d-flex align-items-center gap-3">
                        <div class="stepper" data-stepper>
                            <button type="button" data-step="-7" aria-label="7 days fewer"><icon name="chevron-left" class="icon-sm" /></button>
                            <input type="number" name="days" value="7" min="1" max="365" aria-label="Days" />
                            <button type="button" data-step="7" aria-label="7 days more"><icon name="chevron-right" class="icon-sm" /></button>
                        </div>
                        <span class="text-muted">more days</span>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Extend</button></div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="suspend-dialog" tabindex="-1" aria-labelledby="suspend-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" method="post" asp-action="Suspend" asp-route-id="@t.Id">
                    <div class="modal-header"><h2 class="modal-title" id="suspend-title">Suspend @t.Name</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                    <div class="modal-body stack">
                        <p class="text-muted mb-0">Its users can still sign in, but only to see the reason. Nothing is deleted; reinstating restores access.</p>
                        <div>
                            <label class="form-label" for="suspend-reason">Reason</label>
                            <textarea class="form-control" id="suspend-reason" name="reason" rows="2" maxlength="500" required placeholder="Shown to the tenant and in the audit trail"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger" type="submit">Suspend</button></div>
                </form>
            </div>
        </div>
    }
}
