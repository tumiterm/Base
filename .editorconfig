root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Layout
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
csharp_prefer_braces = when_multiline:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Namespaces must match folders (FO had Domain namespaces inside Application).
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = error

# Hygiene
dotnet_diagnostic.IDE0005.severity = warning   # unnecessary usings
dotnet_diagnostic.IDE0161.severity = error     # file-scoped namespaces
dotnet_diagnostic.IDE0059.severity = warning   # unused assignment
dotnet_diagnostic.IDE0060.severity = warning   # unused parameter

# Naming: constants and static readonly fields are PascalCase; private instance fields are _camelCase.
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_rule.static_readonly_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_pascal.style = pascal
dotnet_naming_rule.static_readonly_pascal.severity = warning
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefix_i.capitalization = pascal_case
dotnet_naming_style.prefix_i.required_prefix = I

# Analyzer tuning: rules that cost more than they buy in an application (not a library).
dotnet_diagnostic.CA1848.severity = none       # LoggerMessage delegates everywhere
dotnet_diagnostic.CA1716.severity = none       # identifiers matching VB keywords
dotnet_diagnostic.CA1711.severity = none       # 'Collection'/'Queue' suffixes
dotnet_diagnostic.CA1515.severity = none       # make public types internal (apps expose to tests)
dotnet_diagnostic.CA1812.severity = none       # DI-instantiated internal classes
dotnet_diagnostic.CA1000.severity = none       # static factories on generic types (ValidationResponse<T>.Success)
dotnet_diagnostic.CA1720.severity = none       # identifiers containing type names (SettingDataType.String)
dotnet_diagnostic.CA2007.severity = none       # ConfigureAwait: no SynchronizationContext in ASP.NET Core
dotnet_diagnostic.MA0004.severity = none       # same as CA2007
dotnet_diagnostic.MA0048.severity = none       # file name must match type name (records grouped by feature)
dotnet_diagnostic.MA0026.severity = suggestion # TODO comments
dotnet_diagnostic.MA0051.severity = suggestion # method too long

# Keep these strict
dotnet_diagnostic.CA2016.severity = error      # forward CancellationToken
dotnet_diagnostic.MA0040.severity = error      # forward CancellationToken
dotnet_diagnostic.CA1849.severity = warning    # sync-over-async
dotnet_diagnostic.CA2100.severity = error      # SQL injection review
dotnet_diagnostic.CA5394.severity = error      # insecure randomness
dotnet_diagnostic.CA2254.severity = error      # constant log templates (structured logging)

[{tests/**.cs,**/Migrations/**.cs}]
dotnet_diagnostic.CA1707.severity = none       # underscores in test names
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.xUnit1051.severity = suggestion   # false positives on NSubstitute Received()/DidNotReceive() checks
dotnet_diagnostic.MA0040.severity = suggestion  # forwarding CancellationToken: production code only
dotnet_diagnostic.MA0002.severity = suggestion  # string comparers: production code only
dotnet_diagnostic.MA0006.severity = suggestion  # string.Equals: production code only
dotnet_diagnostic.MA0016.severity = suggestion  # collection abstractions on test doubles
dotnet_diagnostic.CA1859.severity = suggestion  # return-type micro-optimisations

[**/Migrations/**.cs]
generated_code = true
